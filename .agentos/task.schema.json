{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalAgent task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "goal",
    "context",
    "allowed_paths",
    "forbidden_changes",
    "acceptance_criteria",
    "verification",
    "dependencies",
    "recovery"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]{1,5}$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "in_progress",
        "verified"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 20
    },
    "context": {
      "type": "string",
      "minLength": 20
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recovery": {
      "type": "string",
      "minLength": 10
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
